# Zugangsdaten – NICHT committen (.env steht in .gitignore)
# Laden in die Shell:  set -a; source .env; set +a

# Runpod (https://www.runpod.io/console/user/settings -> API Keys)
RUNPOD_API_KEY=

# Kaggle (kaggle.com -> Settings -> API). Alternativ zu ~/.kaggle/kaggle.json
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face (optional, für Modell-Downloads)
HF_TOKEN=

# Weitere Keys hier ergänzen
